object list --class Hosts --all | JQ '[.[] | select(.data.facts.operating_system.major_version != null and .data.facts.operating_system.kernel != null) | {host: .Name, os_major: .data.facts.operating_system.major_version, kernel: .data.facts.operating_system.kernel, kernel_key: ([.data.facts.operating_system.kernel | splits("[^0-9]+") | select(length > 0) | tonumber])}] | group_by(.os_major) | map((max_by(.kernel_key)) as $latest | .[] | select(.kernel_key < $latest.kernel_key) | {os_major, host, kernel, latest_kernel: $latest.kernel}) | sort_by([(.os_major | tonumber), .host])'
