#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$SCRIPT_DIR/hubuum-common.sh"

usage() {
    command cat <<'EOF'
Usage: hubuum-host [--id IDENTIFIER] [--verbose] [--json] [IDENTIFIER]

Show a Hubuum Host and its Jack/Room placement.
The identifier may be an object name or ID, hostname, FQDN, IP address,
MAC address, or serial number. The local hostname is used by default.
EOF
}

display() {
    local label=$1
    local value=${2:-}
    local indent=${3:-0}
    local width=$((34 - indent))
    [[ $width -gt 0 ]] || width=1
    printf '%*s%-*s -> %s\n' "$indent" '' "$width" "$label" "$value"
}

identifier=
identifier_option=
verbose=0
json_output=0

while [[ $# -gt 0 ]]; do
    case $1 in
        --id)
            [[ $# -ge 2 ]] || { printf '%s\n' "hubuum-host: --id requires a value" >&2; exit 2; }
            identifier_option=$2
            shift 2
            ;;
        --verbose|-v)
            verbose=1
            shift
            ;;
        --json)
            json_output=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            if [[ $# -gt 1 ]]; then
                printf '%s\n' "hubuum-host: expected at most one identifier" >&2
                exit 2
            fi
            identifier=${1:-}
            shift "$#"
            ;;
        -*)
            printf 'hubuum-host: unknown option: %s\n' "$1" >&2
            exit 2
            ;;
        *)
            if [[ -n $identifier ]]; then
                printf '%s\n' "hubuum-host: expected at most one identifier" >&2
                exit 2
            fi
            identifier=$1
            shift
            ;;
    esac
done

if [[ -n $identifier && -n $identifier_option ]]; then
    printf '%s\n' "hubuum-host: specify the identifier positionally or with --id" >&2
    exit 2
fi
identifier=${identifier_option:-${identifier:-$(hostname)}}

hubuum_init
host_json=$(hubuum_resolve_host "$identifier") || exit $?
host_name=$(jq -r '.name' <<<"$host_json")
jacks_json=$(hubuum_related_names \
    "$HUBUUM_HOSTS_CLASS" "$host_name" "$HUBUUM_JACKS_CLASS")
placement_json='[]'
while IFS= read -r jack; do
    rooms_json=$(hubuum_related_names \
        "$HUBUUM_JACKS_CLASS" "$jack" "$HUBUUM_ROOMS_CLASS")
    placement_json=$(jq -c \
        --arg jack "$jack" \
        --argjson rooms "$rooms_json" \
        '. + [{jack: $jack, rooms: $rooms}]' <<<"$placement_json")
done < <(jq -r '.[]' <<<"$jacks_json")

if [[ $json_output -eq 1 ]]; then
    jq -n --argjson host "$host_json" --argjson placement "$placement_json" \
        '{host: $host, placement: $placement}'
    exit 0
fi

display name "$(jq -r '.name // ""' <<<"$host_json")"
display id "$(jq -r '.id // ""' <<<"$host_json")"
display description "$(jq -r '.description // ""' <<<"$host_json")"
display collection "$(jq -r '.collection // ""' <<<"$host_json")"

if [[ $verbose -eq 1 ]]; then
    while IFS=$'\t' read -r key value; do
        display "$key" "$value"
    done < <(jq -r '
        .data
        | paths(scalars) as $path
        | [
            ("data." + ($path | map(tostring) | join("."))),
            (getpath($path) | if . == null then "" else tostring end)
          ]
        | @tsv
    ' <<<"$host_json")
else
    while IFS=$'\t' read -r key value; do
        display "$key" "$value"
    done < <(jq -r '
        .data.facts as $facts
        | [
            ["hostname", $facts.identity.hostname],
            ["fqdn", $facts.identity.fqdn],
            ["ipv4_address", $facts.network.default_ipv4.address],
            ["ipv4_gateway", $facts.network.default_ipv4.gateway],
            ["ipv4_interface", $facts.network.default_ipv4.interface],
            ["ipv6_address", $facts.network.default_ipv6.address],
            ["serial_number", $facts.hardware.serial_number],
            ["hardware_model", $facts.hardware.model],
            ["memory_mb", $facts.hardware.memory_mb],
            ["processor", $facts.hardware.processor.summary],
            ["os_distribution", $facts.operating_system.distribution],
            ["os_version", $facts.operating_system.version],
            ["kernel", $facts.operating_system.kernel],
            ["host_type", $facts.classification.host_type],
            ["virtualization_role", $facts.virtualization.role],
            ["virtualization_type", $facts.virtualization.type],
            ["uptime_seconds", $facts.activity.uptime_seconds],
            ["last_top_user", $facts.activity.last_top_user],
            ["mac_addresses", ($facts.network.interfaces // [] | map(.mac_address // empty) | join(", "))],
            ["facts_source", $facts.source],
            ["collected_at", $facts.collected_at]
          ]
        | .[]
        | [.[0], (.[1] // "" | tostring)]
        | @tsv
    ' <<<"$host_json")
fi

if [[ $(jq 'length' <<<"$placement_json") -eq 0 ]]; then
    display jack ''
else
    while IFS= read -r placement; do
        display jack "$(jq -r '.jack' <<<"$placement")"
        if [[ $(jq '.rooms | length' <<<"$placement") -eq 0 ]]; then
            display room '' 2
        else
            while IFS= read -r room; do
                display room "$room" 2
            done < <(jq -r '.rooms[]' <<<"$placement")
        fi
    done < <(jq -c '.[]' <<<"$placement_json")
fi
