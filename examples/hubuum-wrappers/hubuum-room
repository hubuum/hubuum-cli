#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR
source "$SCRIPT_DIR/hubuum-common.sh"

usage() {
    command cat <<'EOF'
Usage: hubuum-room [--id IDENTIFIER] [--json] [IDENTIFIER]

Show a Hubuum Room, its Jacks, and the Hosts connected to each Jack.
The identifier is a Room name (case-insensitive) or object ID and is required.
An initial B is optional: 701 finds B701 if no Room name or object ID matches 701.
Like miami_room, text output includes comments and each Host's IP, name, and CPU.
Use --json for the complete Room, Jack, and Host objects.
EOF
}

identifier=
json_output=0

while [[ $# -gt 0 ]]; do
    case $1 in
        --id)
            [[ $# -ge 2 && -n $2 && $2 != -* ]] || {
                printf '%s\n' "hubuum-room: --id requires a value" >&2
                exit 2
            }
            [[ -z $identifier ]] || {
                printf '%s\n' "hubuum-room: expected exactly one identifier" >&2
                exit 2
            }
            identifier=$2
            shift 2
            ;;
        --json)
            json_output=1
            shift
            ;;
        --help|-h|--man)
            usage
            exit 0
            ;;
        --)
            shift
            [[ -z $identifier && $# -eq 1 ]] || {
                printf '%s\n' "hubuum-room: expected exactly one identifier" >&2
                exit 2
            }
            identifier=$1
            shift
            ;;
        -*)
            printf 'hubuum-room: unknown option: %s\n' "$1" >&2
            exit 2
            ;;
        *)
            [[ -z $identifier && -n $1 ]] || {
                printf '%s\n' "hubuum-room: expected exactly one identifier" >&2
                exit 2
            }
            identifier=$1
            shift
            ;;
    esac
done

[[ -n $identifier ]] || { usage >&2; exit 2; }

hubuum_init
if room_json=$(hubuum_resolve_object "$HUBUUM_ROOMS_CLASS" "$identifier" \
    2>"$HUBUUM_WRAPPER_TMP/resolve-error"); then
    :
else
    status=$?
    if [[ $status -eq 3 && $identifier != [Bb]* ]]; then
        room_json=$(hubuum_resolve_object "$HUBUUM_ROOMS_CLASS" "B$identifier")
    else
        command cat "$HUBUUM_WRAPPER_TMP/resolve-error" >&2
        exit "$status"
    fi
fi
room_name=$(jq -r '.name' <<<"$room_json")
graph_json=$(hubuum_json relation object graph \
    --root-class "$HUBUUM_ROOMS_CLASS" --root-object "$room_name" \
    --max-depth 2 --data)
# Use edges rather than shortest paths so a Host appears under every connected Jack.
jacks_json=$(jq -ce \
    --arg room_class "$HUBUUM_ROOMS_CLASS" --arg room_name "$room_name" \
    --arg jack_class "$HUBUUM_JACKS_CLASS" --arg host_class "$HUBUUM_HOSTS_CLASS" '
    def key($class; $name): [$class, $name] | tojson;
    INDEX(.objects[]; key(.class; .name)) as $objects
    | (reduce .relations[] as $edge ({};
        .[key($edge.class_a; $edge.object_a)] +=
            [{class: $edge.class_b, name: $edge.object_b}]
        | .[key($edge.class_b; $edge.object_b)] +=
            [{class: $edge.class_a, name: $edge.object_a}]
      )) as $neighbors
    | def related($class; $name; $target):
        ($neighbors[key($class; $name)] // [])
        | map(select(.class == $target) | .name)
        | unique | sort_by(ascii_downcase);
      def object($class; $name):
        $objects[key($class; $name)]
        | if . == null or (has("data") | not)
          then error("missing object data in room graph: " + $class + "/" + $name)
          else del(.depth, .path)
          end;
      related($room_class; $room_name; $jack_class)
      | map(. as $jack | {
          jack: object($jack_class; $jack),
          hosts: (related($jack_class; $jack; $host_class)
              | map(object($host_class; .)))
        })
' <<<"$graph_json")

if [[ $json_output -eq 1 ]]; then
    jq -s '{room: .[0], jacks: .[1]}' < <(printf '%s\n' "$room_json" "$jacks_json")
    exit 0
fi

comment=$(jq -r '.data.comment // ""' <<<"$room_json")
printf '%s' "$room_name"
[[ -z $comment ]] || printf ' (%s)' "$comment"
printf '\n\nJacks:\n'
while IFS= read -r placement; do
    jq -r '.jack | "  " + .name +
        (if (.data.comment // "") == "" then "" else " - " + .data.comment end)' \
        <<<"$placement"
    while IFS=$'\t' read -r address name processor; do
        printf '    %-16s %-25s %s\n' "$address" "$name" "$processor"
    done < <(jq -r '
        def present: select(. != null and . != "");
        .hosts[] | [
            ((.data.facts.network.default_ipv4.address | present) // .name),
            ((.data.facts.identity.fqdn | present)
                // (.data.facts.identity.hostname | present) // .name),
            (.data.facts.hardware.processor.summary // "")
        ] | @tsv
    ' <<<"$placement")
done < <(jq -c '.[]' <<<"$jacks_json")
